{
  "name": "checkin-helper",
  "version": "2.0.1",
  "description": "Tool for event check-in. Saves contacts to Dallas Urbanists database.",
  "author": "Hexel Colorado",
  "type": "module",
  "license": "MIT",
  "stackblitz": {
    "startCommand": "npm start"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "fix": "npm run lint -- --fix",
    "test": "npm run build && npm run lint",
    "test:e2e": "playwright test",
    "routes": "node scripts/list-routes.js",
    "major": "npm version major && git push origin main --tags",
    "minor": "npm version minor && git push origin main --tags",
    "patch": "npm version patch && git push origin main --tags"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "dompurify": "^3.4.16",
    "firebase": "^12.19.0",
    "marked": "^18.0.14",
    "vue": "^3.5.31",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "sass": "^1.103.1",
    "sass-loader": "^17.0.0",
    "vite": "^8.2.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-loader": "^17.4.2"
  }
}
